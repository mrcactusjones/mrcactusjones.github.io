# Copy this file to `.env` (same folder) and fill in your key.
# .env is git-ignored; nothing in it is ever committed.
PPT_API_KEY=your_pokemonpricetracker_key_here

# Optional: override if the API base path turns out to be different.
# PPT_API_BASE=https://www.pokemonpricetracker.com/api/v1

# eBay Browse API -- live listings, for finding actual copies to buy.
# From developer.ebay.com -> Application Keysets. Use the PRODUCTION keyset;
# Sandbox returns invented listings. Client ID is the "App ID", Client Secret
# is the "Cert ID". Both are secrets: this file is the only place they go.
EBAY_CLIENT_ID=your_production_app_id_here
EBAY_CLIENT_SECRET=your_production_cert_id_here
